DATABASE_URL=postgres://shanatech:shanatech@127.0.0.1:5433/shanatech
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email notifikasi (opsional). Isi RESEND_API_KEY untuk mengaktifkan pengiriman.
# Tanpa API key, semua kiriman tetap tersimpan di PostgreSQL.
RESEND_API_KEY=
RESEND_FROM="SHANATECH <onboarding@resend.dev>"
NOTIFY_EMAIL=hello@shanatech.web.id

# Panel admin (/admin)
# Buat hash password dengan: npm run admin:hash -- "password-anda"
# Format: scrypt:salt:hash — jangan gunakan "$" karena dotenv-expand akan memotongnya.
ADMIN_EMAIL=admin@shanatech.id
ADMIN_PASSWORD_HASH=
# Buat dengan: openssl rand -hex 32
SESSION_SECRET=

# Backup database (panel admin)
# Folder penyimpanan .dump. Kosongkan untuk memakai ./backups.
# Wajib memakai disk persisten bila di-deploy, bukan filesystem serverless.
BACKUP_DIR=
# Path biner PostgreSQL jika tidak tersedia di PATH proses server.
PG_DUMP_PATH=pg_dump
PG_RESTORE_PATH=pg_restore

# Cloudflare R2 — gambar produk (maksimal 5 MB per gambar).
# Token bucket khusus dengan izin Object Read & Write; jangan pakai NEXT_PUBLIC_.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Domain publik HTTPS tanpa slash akhir, contoh https://media.domain-anda.id
R2_PUBLIC_BASE_URL=
# Atur CORS bucket untuk origin aplikasi; lihat DEPLOY.md bagian Cloudflare R2.
