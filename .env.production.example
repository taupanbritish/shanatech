# Salin menjadi .env.production lalu isi nilainya.
# Jangan commit .env.production.

# ── Domain & PostgreSQL ──────────────────────────────────────────────
# Domain untuk Caddy (profil tls). Biarkan kosong jika belum memakai HTTPS.
SITE_DOMAIN=
POSTGRES_DB=shanatech
POSTGRES_USER=shanatech
# Gunakan karakter hex agar aman dirangkai ke DATABASE_URL.
# Buat dengan: openssl rand -hex 24
POSTGRES_PASSWORD=

# ── Aplikasi ─────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://shanatech.web.id
# 127.0.0.1 = hanya bisa diakses lewat reverse proxy/SSH tunnel.
# Ganti 0.0.0.0 hanya untuk uji sementara tanpa domain.
APP_BIND=127.0.0.1

ADMIN_EMAIL=admin@shanatech.id
# Buat dengan: docker run --rm -v "$PWD":/app -w /app node:24-bookworm-slim node scripts/hash-password.mjs "password-anda"
ADMIN_PASSWORD_HASH=
# Buat dengan: openssl rand -hex 32
SESSION_SECRET=

RESEND_API_KEY=
RESEND_FROM="SHANATECH <no-reply@shanatech.web.id>"
NOTIFY_EMAIL=hello@shanatech.web.id

BACKUP_DIR=/app/backups
PG_DUMP_PATH=pg_dump
PG_RESTORE_PATH=pg_restore
